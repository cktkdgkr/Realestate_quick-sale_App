{#- 주간 급매 리포트. 외부 CSS·JS 없음, 인라인 스타일과 table 레이아웃만 사용, 폭 600px 기준.
    본문 순서 (notify 스킬 §4, 웹 링크 제외):
    1 요약 박스  2 이번 주 알림(신규·가격 인하)  3 지속 중  4 지난주 급매 중 내려간 매물
    5 단지·평형별 현황  6 교차검증 경고·수집 오류  7 바닥글 -#}
{% macro bargain_card(it) %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:0 0 10px 0;border:1px solid #d0d7de;">
  <tr>
    <td style="padding:10px 12px;font-size:14px;line-height:1.5;">
      {% if it.kind == "NEW" %}<span style="display:inline-block;background:#d1242f;color:#ffffff;font-weight:bold;padding:1px 6px;font-size:12px;">신규</span>
      {% elif it.kind == "PRICE_DROP" %}<span style="display:inline-block;background:#bc4c00;color:#ffffff;font-weight:bold;padding:1px 6px;font-size:12px;">가격 인하</span>
      {% else %}<span style="display:inline-block;background:#57606a;color:#ffffff;font-weight:bold;padding:1px 6px;font-size:12px;">지속 중</span>
      {% endif %}
      <strong>{{ it.complex_name }}</strong> {{ it.area_label }}<br>
      <span style="color:#57606a;">{{ it.dong }} · {{ it.floor_raw }} ({{ it.floor_label }}){% if it.direction %} · {{ it.direction }}{% endif %}</span><br>
      {% if it.kind == "PRICE_DROP" %}
      <span style="font-size:16px;">매매 <s style="color:#57606a;">{{ it.prev_price_text }}</s> → <strong>{{ it.price_text }}</strong></span> <span style="color:#bc4c00;">가격 인하 (이전가 → 현재가)</span><br>
      {% else %}
      <span style="font-size:16px;">매매 <strong>{{ it.price_text }}</strong></span>{% if it.discount_pct is not none %} <span style="color:#d1242f;">최대 {{ it.discount_pct }}% 낮음</span>{% endif %}<br>
      {% endif %}
      {% for r in it.reasons %}
      <span style="display:block;color:#24292f;">근거: {{ r }}</span>
      {% endfor %}
      <span style="color:#57606a;font-size:12px;">중개사 {{ it.realtor_count }}곳{% if it.alt_prices_text %} · 다른 중개사 호가 {{ it.alt_prices_text }}{% endif %}{% if it.confirmed_at %} · 확인일 {{ it.confirmed_at }}{% endif %}</span><br>
      <a href="{{ it.url }}" style="color:#0969da;font-size:13px;">네이버 매물 보기</a>
    </td>
  </tr>
</table>
{% endmacro %}
{% macro section_title(text) %}
<h2 style="font-size:17px;margin:24px 0 8px 0;padding:0 0 4px 0;border-bottom:2px solid #24292f;">{{ text }}</h2>
{% endmacro %}
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ v.title }}</title>
</head>
<body style="margin:0;padding:0;background:#f6f8fa;font-family:-apple-system,'Apple SD Gothic Neo','Malgun Gothic',sans-serif;color:#24292f;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;background:#f6f8fa;">
<tr><td align="center" style="padding:12px 8px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%;max-width:600px;background:#ffffff;">
<tr><td style="padding:16px;">

<h1 style="font-size:20px;margin:0 0 4px 0;">급매 주간 리포트 {{ v.date_label }}</h1>
{% if v.dry_run %}<p style="margin:0 0 8px 0;color:#57606a;font-size:13px;">드라이런: 이력 DB를 갱신하지 않았고 reports 브랜치에 올리지 않습니다.</p>{% endif %}

<!-- 1. 요약 박스 -->
{% if v.has_failure %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:8px 0;background:#ffebe9;border:2px solid #d1242f;">
<tr><td style="padding:12px;font-size:14px;line-height:1.6;">
  <strong style="font-size:16px;color:#d1242f;">수집 실패</strong>
  {% if v.status == "FAILED" %}— 이번 실행은 수집에 실패해 급매 판정을 하지 못했습니다. "급매 없음"이 아닙니다.{% else %}— 아래 단지·평형은 이번 주 판정에서 빠졌습니다. "급매 없음"이 아닙니다.{% endif %}
  {% for r in v.failed_rows %}<br>· <strong>{{ r.name }}</strong> ({{ r.complex_no }}): {{ r.failure_text }}{% endfor %}
  {% for r, a in v.area_fail_rows %}<br>· <strong>{{ r.name }}</strong> {{ a.label }}: {{ a.failure_text }}{% endfor %}
  {% if not v.failed_rows and not v.area_fail_rows and v.status != "FAILED" %}<br>· 일부 수집 오류가 있습니다. 6번 "수집 오류"를 확인하세요.{% endif %}
</td></tr>
</table>
{% endif %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:8px 0;background:#f6f8fa;border:1px solid #d0d7de;">
<tr><td style="padding:12px;font-size:14px;line-height:1.7;">
  실행 상태: <strong{% if v.status != "OK" %} style="color:#d1242f;"{% endif %}>{{ v.status }} ({{ v.status_label }})</strong><br>
  조사 단지: {{ v.complex_count }}곳{% if v.failed_rows %} <span style="color:#d1242f;">(수집 실패 {{ v.failed_rows|length }}곳)</span>{% endif %}<br>
  신규 <strong>{{ v.counts.NEW }}</strong> · 가격 인하 <strong>{{ v.counts.PRICE_DROP }}</strong> · 지속 중 <strong>{{ v.counts.ONGOING }}</strong> · 내려간 매물 <strong>{{ v.gone|length }}</strong>
  {% if v.molit_missing %}<br><span style="color:#9a6700;font-weight:bold;">실거래 매칭 확인 필요: {% for r in v.molit_missing %}{{ r.name }}{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
  {% if v.no_trade_areas %}<br><span style="color:#9a6700;font-weight:bold;">실거래 부족: {{ v.no_trade_areas }}개 평형</span>{% endif %}
  {% if v.unknown_total %}<br><span style="color:#9a6700;font-weight:bold;">층 미상: 매물 {{ v.unknown_total }}건 (판정 제외)</span>{% endif %}
</td></tr>
</table>

<!-- 2. 이번 주 알림 -->
{{ section_title("이번 주 알림 (신규 · 가격 인하)") }}
{% for it in v.alerts %}{{ bargain_card(it) }}{% else %}
<p style="font-size:14px;margin:4px 0;">{% if v.status == "FAILED" %}<strong style="color:#d1242f;">수집 실패로 급매를 확인하지 못했습니다.</strong>{% elif v.has_failure %}수집에 성공한 단지에서는 신규·가격 인하 급매가 없습니다. <strong style="color:#d1242f;">수집 실패 단지는 확인하지 못했습니다.</strong>{% else %}신규·가격 인하 급매가 없습니다.{% endif %}</p>
{% endfor %}

<!-- 3. 지속 중 -->
{{ section_title("지속 중인 급매") }}
{% for it in v.ongoing %}{{ bargain_card(it) }}{% else %}
<p style="font-size:14px;margin:4px 0;color:#57606a;">없음</p>
{% endfor %}

<!-- 4. 지난주 급매 중 내려간 매물 -->
{% if v.gone %}
{{ section_title("지난주 급매 중 내려간 매물") }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:13px;">
{% for g in v.gone %}
<tr><td style="padding:6px 4px;border-bottom:1px solid #d0d7de;line-height:1.5;">
  <strong>{{ g.complex_name }}</strong> {{ g.area_label }}{% if g.where %} · {{ g.where }}{% endif %}<br>
  {{ g.reason_text }} · 마지막 알림가 {{ g.last_price_text }}{% if g.current_price_text %} → 현재 {{ g.current_price_text }}{% endif %}{% if g.first_alerted %} · 최초 알림 {{ g.first_alerted }}{% endif %}
  {% if g.url %}<br><a href="{{ g.url }}" style="color:#0969da;">네이버 매물 보기</a>{% else %}<br><span style="color:#57606a;font-size:11px;">식별: {{ g.dedup_key }}</span>{% endif %}
</td></tr>
{% endfor %}
</table>
{% endif %}

<!-- 5. 단지·평형별 현황 -->
{{ section_title("단지·평형별 현황") }}
{% for r in v.status_rows %}
<h3 style="font-size:15px;margin:16px 0 4px 0;">{{ r.name }} <span style="color:#57606a;font-weight:normal;font-size:12px;">({{ r.complex_no }}){% if r.address %} {{ r.address }}{% endif %}</span></h3>
{% if r.failed %}
<p style="margin:4px 0;padding:8px;background:#ffebe9;border:1px solid #d1242f;color:#d1242f;font-size:14px;"><strong>수집 실패</strong> — {{ r.failure_text }}. 이 단지는 이번 주 판정에서 빠졌습니다 ("급매 없음" 아님).</p>
{% endif %}
{% if r.molit_missing %}
<div style="margin:4px 0;padding:8px;background:#fff8c5;border:1px solid #d4a72c;font-size:13px;line-height:1.6;">
  <strong style="color:#9a6700;">실거래 매칭 확인 필요</strong> — 국토부 단지 식별자(molit_apt_seq)가 없어 이 단지의 실거래를 쓰지 못했습니다.<br>
  {% if r.candidates %}후보:
  {% for c in r.candidates %}<br>· <code>{{ c.seq if c.seq else "(식별자 없음)" }}</code>{% if c.desc %} {{ c.desc }}{% endif %}{% endfor %}
  {% else %}후보를 찾지 못했습니다. 국토부 실거래가 공개시스템에서 단지를 직접 확인하세요.{% endif %}
  <br>해결 방법: {{ v.complexes_file }}의 이 단지 항목에 아래처럼 적고 다음 실행을 기다리세요.
  <pre style="margin:4px 0;padding:6px;background:#ffffff;border:1px solid #d0d7de;font-size:12px;white-space:pre-wrap;">  - complex_no: "{{ r.complex_no }}"
    name: {{ r.name }}
    molit_apt_seq: "{{ r.candidates[0].seq if r.candidates and r.candidates[0].seq else "후보 중 맞는 식별자" }}"</pre>
</div>
{% endif %}
{% if r.areas %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:12px;">
<tr style="background:#f6f8fa;">
  <th align="left" style="padding:4px;border-bottom:1px solid #d0d7de;">평형</th>
  <th align="right" style="padding:4px;border-bottom:1px solid #d0d7de;">일반층 실거래 중앙값</th>
  <th align="right" style="padding:4px;border-bottom:1px solid #d0d7de;">일반층 매물 최저</th>
  <th align="right" style="padding:4px;border-bottom:1px solid #d0d7de;">저층 매물 최저</th>
  <th align="right" style="padding:4px;border-bottom:1px solid #d0d7de;">매물</th>
</tr>
{% for a in r.areas %}
<tr>
  <td style="padding:4px;border-bottom:1px solid #eaeef2;">{{ a.label }}</td>
  {% if a.failed %}
  <td colspan="4" style="padding:4px;border-bottom:1px solid #eaeef2;color:#d1242f;font-weight:bold;">수집 실패 — {{ a.failure_text }}</td>
  {% elif r.failed and a.missing %}
  <td colspan="4" style="padding:4px;border-bottom:1px solid #eaeef2;color:#d1242f;font-weight:bold;">수집 실패</td>
  {% elif a.missing %}
  <td colspan="4" style="padding:4px;border-bottom:1px solid #eaeef2;color:#9a6700;font-weight:bold;">결과 없음 (확인 필요)</td>
  {% else %}
  <td align="right" style="padding:4px;border-bottom:1px solid #eaeef2;">{% if a.no_trade %}<strong style="color:#9a6700;">실거래 부족</strong>{% else %}{{ a.t_normal_text }} ({{ a.trade_count }}건{% if a.short %}, <span style="color:#9a6700;">표본 부족</span>{% endif %}){% endif %}{% if a.low_trade_ref %}<br><span style="color:#57606a;">저층 실거래(참고) {{ a.low_trade_ref }}</span>{% endif %}</td>
  <td align="right" style="padding:4px;border-bottom:1px solid #eaeef2;">{{ a.l_normal_text }}</td>
  <td align="right" style="padding:4px;border-bottom:1px solid #eaeef2;">{{ a.l_low_text }}</td>
  <td align="right" style="padding:4px;border-bottom:1px solid #eaeef2;">{{ a.listing_count }}건{% if a.unknown_count %}<br><strong style="color:#9a6700;">층 미상 {{ a.unknown_count }}건</strong>{% endif %}</td>
  {% endif %}
</tr>
{% endfor %}
</table>
{% elif not r.failed %}
<p style="font-size:13px;margin:4px 0;color:#9a6700;">조사 대상 평형(공급 119.0㎡ 이하)이 없습니다.</p>
{% endif %}
{% if r.unknown_listings %}
<p style="font-size:12px;margin:6px 0 2px 0;color:#9a6700;font-weight:bold;">층 미상 매물 (판정 제외)</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:12px;">
{% for u in r.unknown_listings %}
<tr><td style="padding:3px 4px;border-bottom:1px solid #eaeef2;">{{ u.area_label }} · {{ u.where }} · {{ u.price_text }} · <a href="{{ u.url }}" style="color:#0969da;">보기</a></td></tr>
{% endfor %}
</table>
{% endif %}
{% endfor %}

<!-- 6. 교차검증 경고·수집 오류 -->
{% if v.warnings or v.errors or v.collector_warnings %}
{{ section_title("교차검증 경고 · 수집 오류") }}
{% if v.errors %}
<p style="font-size:13px;margin:4px 0;font-weight:bold;color:#d1242f;">수집 오류</p>
<ul style="margin:0 0 8px 0;padding-left:18px;font-size:12px;">{% for e in v.errors %}<li>{{ e }}</li>{% endfor %}</ul>
{% endif %}
{% if v.collector_warnings %}
<p style="font-size:13px;margin:4px 0;font-weight:bold;color:#9a6700;">수집 경고</p>
<ul style="margin:0 0 8px 0;padding-left:18px;font-size:12px;">{% for w in v.collector_warnings %}<li>{{ w }}</li>{% endfor %}</ul>
{% endif %}
{% if v.warnings %}
<p style="font-size:13px;margin:4px 0;font-weight:bold;color:#9a6700;">교차검증 경고 (국토부 기준으로 판정)</p>
<ul style="margin:0 0 8px 0;padding-left:18px;font-size:12px;">{% for w in v.warnings %}<li>{{ w }}</li>{% endfor %}</ul>
{% endif %}
{% endif %}

<!-- 7. 바닥글 -->
<p style="margin:24px 0 0 0;padding:8px 0 0 0;border-top:1px solid #d0d7de;font-size:11px;color:#57606a;line-height:1.6;">
  데이터 출처: 국토교통부 아파트 매매 실거래가(공공데이터포털), 네이버 부동산 매물.<br>
  실거래는 계약 후 30일 이내 신고되므로 최근 거래가 아직 반영되지 않았을 수 있습니다. 해제된 거래는 기준값에서 뺐습니다.<br>
  판정 기준: 일반층 매물은 일반층 실거래 중앙값(최근 24개월, 최신 3건) 또는 다른 일반층 매물 최저가의 95% 이하, 저층(1·2층·지하·'저') 매물은 같은 기준값의 90% 이하. 층 미상 매물은 판정하지 않습니다.<br>
  실행 ID: {{ v.run_id }}
</p>

</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
