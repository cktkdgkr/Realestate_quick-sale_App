# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 않습니다.
# 실제 환경변수가 있으면 .env 보다 우선합니다 (Routine 세션에서는 환경변수로 넣는 것을 권장).

# 공공데이터포털 "국토교통부_아파트 매매 실거래가 상세 자료" 인증키 (무료). 일반 인증키(Decoding) 값.
MOLIT_API_KEY=

# true면 이력 DB(재알림 이력)를 갱신하지 않고 리포트·요약만 만듭니다.
DRY_RUN=false

# 실행 시간대. 바꾸지 마세요.
TZ=Asia/Seoul

# 아래 경로는 저장소 루트 기준 상대 경로 또는 절대 경로. 비워 두면 기본값.
DB_PATH=state/history.sqlite3
REPORT_DIR=reports
OUT_DIR=out
COMPLEXES_FILE=config/complexes.yaml
